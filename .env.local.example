# ── Public site URL (used for canonical URLs, sitemap, OG tags) ──
# No trailing slash. Set to your real domain in production.
NEXT_PUBLIC_SITE_URL=https://ozzo.app

# ── Supabase (wacrm project) — used server-side to store inquiries ──
NEXT_PUBLIC_SUPABASE_URL=https://gxurqwpfvfktmreqmzqb.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ── Email alerts for new inquiries (optional but recommended) ──
# Uses Resend (https://resend.com). Leave RESEND_API_KEY empty to disable
# email — inquiries are still saved to the database.
RESEND_API_KEY=
# Where new-lead alerts are sent (your sales/team inbox):
INQUIRY_NOTIFY_EMAIL=sales@ozzo.app
# Verified "from" address on your Resend domain:
INQUIRY_FROM_EMAIL=OZZO Website <notifications@ozzo.app>
